---
/** The page shell: head, floating header with theme toggle, footer. Every page shares it. */
type Props = { title: string; description: string }
const { title, description } = Astro.props
const BASE = import.meta.env.BASE_URL.replace(/\/?$/, '/')
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500&display=swap" />
    <script is:inline>
      // Before paint: the saved theme, else the system one. Storage can throw in private mode.
      ;(() => {
        let t = null
        try {
          t = localStorage.getItem('opaline-theme')
        } catch {}
        if (t !== 'light' && t !== 'dark') t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'
        document.documentElement.dataset.theme = t
      })()
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="bar">
        <a class="brand" href={BASE}><span>opaline</span><span class="brand-dot" aria-hidden="true"></span></a>
        <nav class="nav" aria-label="Sections">
          <a href={`${BASE}#playground`}>Playground</a>
          <a class="wide" href={`${BASE}#gallery`}>Gallery</a>
          <a class="wide" href={`${BASE}#demos`}>Demos</a>
          <a href={`${BASE}#docs`}>Docs</a>
          <a href={`${BASE}compare/`}>Compare</a>
        </nav>
        <span class="spacer"></span>
        <a class="gh" href="https://github.com/Inlaylab/Opaline" target="_blank" rel="noreferrer" aria-label="GitHub repository">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.04-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.76 2.7 1.25 3.36.96.1-.75.4-1.25.73-1.54-2.56-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.42-2.69 5.39-5.25 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z" /></svg><span>GitHub</span>
        </a>
        <button class="icon-btn" id="theme-toggle" type="button" aria-label="Toggle dark mode">
          <svg class="moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" /></svg>
          <svg class="sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2m-7.07-17.07 1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" /></svg>
        </button>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer>
      <div class="wrap">
        <span>Opaline by Inlaylab. MIT for code and art.</span>
        <a href="https://github.com/Inlaylab/Opaline">github.com/Inlaylab/Opaline</a>
      </div>
    </footer>

    <script>
      import '@inlaylab/opaline-element'
      import '../styles/site.css'

      document.getElementById('theme-toggle')!.addEventListener('click', () => {
        const root = document.documentElement
        const next = root.dataset.theme === 'dark' ? 'light' : 'dark'
        root.dataset.theme = next
        try {
          localStorage.setItem('opaline-theme', next)
        } catch {}
      })
    </script>
  </body>
</html>
