---
import Base from '../layouts/Base.astro'
import { STYLE_INFO } from '../data/styles'

const STYLES = STYLE_INFO.map((s) => [s.id, s.name, s.hint])
const PALETTES = ['', 'pastel', 'electric', 'muted', 'warm', 'cool', 'mono']
const EXPRESSIONS = ['beam', 'content', 'proud', 'dreamy', 'hmm', 'shy', 'sleepy', 'curious', 'oh', 'cheeky', 'wink', 'giggle', 'starry', 'love', 'laugh', 'cool', 'nice', 'smug', 'yawn', 'wow']
const FACES = ['grin', 'beam', 'laugh', 'hearts', 'starry', 'wink', 'cheeky', 'whistle', 'smug', 'cool', 'boss', 'meh', 'chill', 'thinking', 'moody', 'dreamy', 'shook', 'oops']
const ANIMALS = ['cat', 'sloth', 'dog', 'hamster', 'rabbit', 'ferret', 'fox', 'panda', 'koala', 'penguin', 'deer', 'frog', 'owl', 'chick', 'axolotl', 'lion', 'pig', 'mouse', 'octopus']
const OBJECTS = ['sun', 'galaxy', 'black hole', 'nebula', 'comet', 'moon', 'crescent', 'star', 'quasar', 'pulsar', 'ufo', 'rocket', 'asteroid', 'supernova', 'satellite']
const SCHEMES = ['natural', 'bare', 'sepia', 'greyscale', 'duotone', 'muted', 'electric', 'inverted', 'pastel', 'bold', 'sunrise']
const GFORMS = ['pebble', 'bean', 'cloud', 'leaf', 'shell', 'wave', 'bun', 'kite', 'cushion']
const TABS = [
  ['core', 'Core'],
  ['react', 'React'],
  ['vue', 'Vue'],
  ['svelte', 'Svelte'],
  ['angular', 'Angular'],
  ['element', 'HTML'],
  ['svg', 'SVG'],
  ['json', 'JSON'],
]
const ACCESSORIES = ['none', 'beret', 'cap', 'beanie', 'glasses', 'shades', 'flower', 'sprout', 'bow', 'star', 'pumpkin', 'party', 'headphones', 'crown']
const FORMS = ['circle', 'squircle', 'triangle', 'hexagon', 'diamond', 'heart', 'drop', 'pill', 'dome', 'star', 'clover', 'shield', 'octagon', 'ghost']
const AT = [24, 32, 40, 56, 80]
---

<Base page="playground" title="Opaline playground: design and export an SVG avatar" description="Design an Opaline avatar: pick a style, colors and shape, then copy the code for your framework or download SVG and PNG.">
  <div class="wrap page-head">
    <div>
      <h1>Design your avatar</h1>
      <p>Pick a style, tweak the details, copy the code. Everything you see is the library's real output, and the address bar always links to it.</p>
    </div>
    <div class="page-actions">
      <button class="btn" id="pg-reset" type="button">Reset options</button>
      <button class="btn primary" id="pg-share" type="button">Copy link</button>
    </div>
  </div>

  <div class="wrap pg2">
    <form class="card pg2-controls" id="pg-controls" aria-label="Avatar options">
      <div class="step">
        <label class="step-title" for="pg-seed">Seed</label>
        <p class="step-hint">A user ID, an email or a name. The same seed always draws the same avatar.</p>
        <div class="seed-row">
          <input class="input" id="pg-seed" value="Starfire" autocomplete="off" spellcheck="false" />
          <button class="btn icon" id="pg-shuffle" type="button" aria-label="Random hero" title="Random hero">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 3h5v5M4 20 21 3M21 16v5h-5M15 15l6 6M4 4l5 5" /></svg>
          </button>
        </div>
      </div>

      <fieldset class="step">
        <legend class="step-title">Style</legend>
        <div class="style-cards">
          {STYLES.map(([value, label, hint], i) => (
            <label class="style-card" title={hint}>
              <input type="radio" name="pg-style" value={value} checked={i === 0} />
              <span class="style-thumb" data-thumb={value}></span>
              <span class="style-name">{label}</span>
              <span class="style-hint">{hint}</span>
            </label>
          ))}
        </div>
      </fieldset>

      <fieldset class="step">
        <legend class="step-title">Color</legend>
        <div class="sub">
          <span class="sub-label sr-only">Palette</span>
          <div class="swatches">
            {PALETTES.map((p) => (
              <label class="swatch" title={p || 'vivid (default)'}>
                <input type="radio" name="pg-palette" value={p} checked={!p} />
                <span data-swatch={p}></span>
                <small>{p || 'vivid'}</small>
              </label>
            ))}
          </div>
        </div>
      </fieldset>

      <fieldset class="step">
        <legend class="step-title">Shape and finish</legend>
        <div class="sub" id="pg-shape-field">
          <span class="sub-label">Shape</span>
          <div class="seg">
            <label><input type="radio" name="pg-shape" value="" checked /><span id="pg-shape-default">None</span></label>
            {['circle', 'squircle', 'square'].map((v) => <label><input type="radio" name="pg-shape" value={v} /><span>{v}</span></label>)}
            <label id="pg-shape-none" hidden><input type="radio" name="pg-shape" value="none" /><span>none</span></label>
          </div>
        </div>
        <div class="sub" id="pg-finish-field">
          <span class="sub-label">Finish</span>
          <div class="seg">
            <label><input type="radio" name="pg-finish" value="" checked /><span>Default</span></label>
            {['flat', 'soft', 'gloss', 'gummy'].map((v) => <label><input type="radio" name="pg-finish" value={v} /><span>{v}</span></label>)}
          </div>
        </div>
      </fieldset>

      <fieldset class="step">
        <legend class="step-title">Details</legend>
        <div class="sub" id="pg-body-field" hidden>
          <span class="sub-label">Body</span>
          <div class="seg">
            <label><input type="radio" name="pg-body" value="" checked /><span>Seeded</span></label>
            {['jelly', 'hood', 'ghost'].map((v) => <label><input type="radio" name="pg-body" value={v} /><span>{v}</span></label>)}
          </div>
        </div>
        <label class="sub" id="pg-accessory-field" hidden>
          <span class="sub-label">Accessory</span>
          <select class="select" id="pg-accessory"><option value="">Seeded</option>{ACCESSORIES.map((a) => <option>{a}</option>)}</select>
        </label>
        <label class="sub" id="pg-form-field" hidden>
          <span class="sub-label">Form</span>
          <select class="select" id="pg-form"><option value="">Seeded</option>{FORMS.map((f) => <option>{f}</option>)}</select>
        </label>
        <label class="sub" id="pg-gform-field" hidden>
          <span class="sub-label">Form</span>
          <select class="select" id="pg-gform"><option value="">Classic</option>{GFORMS.map((f) => <option>{f}</option>)}</select>
        </label>
        <label class="sub" id="pg-animal-field" hidden>
          <span class="sub-label">Animal</span>
          <select class="select" id="pg-animal"><option value="">Seeded</option>{ANIMALS.map((a) => <option>{a}</option>)}</select>
        </label>
        <label class="sub" id="pg-coat-field" hidden>
          <span class="sub-label">Coat</span>
          <select class="select" id="pg-coat"><option value="">Natural</option><option>palette</option></select>
        </label>
        <label class="sub" id="pg-object-field" hidden>
          <span class="sub-label">Object</span>
          <select class="select" id="pg-object"><option value="">Seeded</option>{OBJECTS.map((o) => <option>{o}</option>)}</select>
        </label>
        <label class="sub" id="pg-scheme-field" hidden>
          <span class="sub-label">Colour look</span>
          <select class="select" id="pg-scheme"><option value="">Default</option>{SCHEMES.map((s) => <option>{s}</option>)}</select>
        </label>
        <label class="sub" id="pg-face-field" hidden>
          <span class="sub-label">Face</span>
          <select class="select" id="pg-face"><option value="">Seeded</option>{FACES.map((f) => <option>{f}</option>)}</select>
        </label>
        <label class="sub" id="pg-status-field">
          <span class="sub-label">Status</span>
          <select class="select" id="pg-status"><option value="">None</option>{['online', 'away', 'busy', 'offline'].map((s) => <option>{s}</option>)}</select>
        </label>
        <label class="sub" id="pg-expression-field">
          <span class="sub-label">Expression</span>
          <select class="select" id="pg-expression"><option value="">Seeded</option>{EXPRESSIONS.map((e) => <option>{e}</option>)}</select>
        </label>
        <label class="sub" id="pg-text-field" hidden>
          <span class="sub-label">Text <small>up to 3 letters</small></span>
          <input class="input" id="pg-text" placeholder="From the seed" maxlength="3" autocomplete="off" spellcheck="false" />
        </label>
      </fieldset>
    </form>

    <div class="pg2-main">
      <div class="card pg2-stage">
        <div class="pg2-bar">
          <span class="at-caption" id="pg-caption"></span>
          <div class="seg view-seg" role="radiogroup" aria-label="Preview background">
            <label><input type="radio" name="pg-view" value="both" checked /><span>Both</span></label>
            <label><input type="radio" name="pg-view" value="light" /><span>Light</span></label>
            <label><input type="radio" name="pg-view" value="dark" /><span>Dark</span></label>
          </div>
        </div>
        <div class="pg-preview" id="pg-preview" data-view="both">
          <div class="pane light" id="pg-light"></div>
          <div class="pane dark" id="pg-dark"></div>
        </div>
        <div class="pg2-sizes" aria-label="At common sizes">
          {AT.map((px) => <span class="at" data-at={px} title={`${px}px`}></span>)}
        </div>
      </div>

      <div class="card code-card">
        <div class="code-head">
          <div class="tabs" id="pg-tabs" role="tablist" aria-label="Code for">
            {TABS.map(([id, label], i) => (
              <button class="tab" type="button" role="tab" data-tab={id} aria-selected={i === 0 ? 'true' : 'false'}>{label}</button>
            ))}
          </div>
        </div>
        <pre class="code" id="pg-code"></pre>
        <div class="code-foot">
          <label class="size-pick"><span class="size-label">Export size</span>
            <select class="select" id="pg-size">{[32, 48, 64, 96, 128, 256, 512].map((n) => <option selected={n === 64}>{n}</option>)}</select>
          </label>
          <span class="spacer"></span>
          <button class="btn" id="pg-copy" type="button">Copy code</button>
          <button class="btn" id="pg-download" type="button">SVG</button>
          <button class="btn" id="pg-png" type="button">PNG</button>
        </div>
      </div>
    </div>
  </div>

  <script>
    import { initPlayground } from '../scripts/playground.ts'
    initPlayground()
  </script>
</Base>
