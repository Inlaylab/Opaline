---
/** Real product screens built only from <opaline-avatar> and <opaline-avatar-group>. */
const BASE = import.meta.env.BASE_URL.replace(/\/?$/, '/')
const CATEGORIES = ['All', 'Social', 'SaaS', 'Teams', 'Messaging']
const USERS = [
  ['Ada Lovelace', 'ada@inlay.dev', 'Owner', 'active', '2 min ago'],
  ['Grace Hopper', 'grace@inlay.dev', 'Admin', 'active', '1 h ago'],
  ['Linus Okafor', 'linus@inlay.dev', 'Editor', 'invited', 'Never'],
  ['Mateo Rossi', 'mateo@inlay.dev', 'Viewer', 'suspended', '12 days ago'],
]
const TEAM = ['ada@inlay.dev', 'grace@inlay.dev', 'linus@inlay.dev', 'mateo@inlay.dev', 'priya@inlay.dev', 'kofi@inlay.dev', 'hana@inlay.dev']
const LIKES = ['Søren', 'Aiko', 'Min-jun', 'Olu', 'Ines', 'Ravi', 'Lena', 'Zoë']
const LEADERS = [
  ['Aiko Tanaka', '12,480'],
  ['Olu Adeyemi', '11,902'],
  ['Ines Duarte', '10,355'],
  ['Ravi Kumar', '9,870'],
  ['Lena Fischer', '9,114'],
]
const INBOX = [
  ['Priya Raman', 'Q4 roadmap review', 'Left a few comments on the pricing section…', '9:41', true],
  ['Kofi Mensah', 'Design crit moved to 3pm', 'Same room, bring the new onboarding flows.', '8:15', true],
  ['Hana Sato', 'Your invoice is ready', 'Invoice #2041 for October is attached.', 'Tue', false],
  ['Mateo Rossi', 'Re: launch checklist', 'All green on my side. Shipping Friday!', 'Mon', false],
]
const NOTES = [
  ['Grace Hopper', 'mentioned you in', 'API rate limits', '2m'],
  ['Søren Berg', 'approved', 'PR #412 · new billing page', '1h'],
  ['Min-jun Park', 'invited you to', 'Mobile v3', '3h'],
]
const CALL = ['Ada Lovelace', 'Kofi Mensah', 'Priya Raman', 'Mateo Rossi', 'Hana Sato', 'Linus Okafor']
---

<section class="block demos-band" id="demos">
  <div class="wrap">
    <div class="sec-head demos-head">
      <h2>See it in real products.</h2>
      <p>Ten screens people build every day, each made from one component. Every face comes from its seed; nothing is uploaded or stored.</p>
    </div>
    <div class="chips segmented demo-filter" id="demo-filter" role="tablist" aria-label="Filter demos">
      {CATEGORIES.map((c, i) => <button class="tab" type="button" role="tab" data-cat={c} aria-selected={i === 0 ? 'true' : 'false'}>{c}</button>)}
    </div>

    <div class="demos">
      <article class="card demo profile-demo" data-cat="Social">
        <div class="profile-cover" aria-hidden="true"></div>
        <div class="profile-body">
          <opaline-avatar class="profile-avatar" seed="maya@inlay.dev" look="clay" finish="gloss" shape="circle" size="88" alt="Maya Chen"></opaline-avatar>
          <div class="profile-head">
            <div><b>Maya Chen</b><span class="muted">@maya · Product designer</span></div>
            <button class="btn primary pill" type="button">Follow</button>
          </div>
          <p class="profile-bio">Designing calm interfaces at Inlay. Tea, type and tiny details.</p>
          <ul class="profile-stats">
            <li><b>128</b> posts</li>
            <li><b>4.2k</b> followers</li>
            <li><b>310</b> following</li>
          </ul>
        </div>
        <footer class="demo-foot"><span class="demo-tag">Profile</span><code>look="clay" finish="gloss"</code></footer>
      </article>

      <article class="card demo" data-cat="Social">
        <div class="post">
          <div class="post-head">
            <opaline-avatar seed="kofi@inlay.dev" look="morph" shape="squircle" size="44" alt="Kofi Mensah"></opaline-avatar>
            <div><b>Kofi Mensah</b><span class="muted">2h · Public</span></div>
          </div>
          <p>Shipped avatars for every signup today. Nobody gets the grey silhouette any more.</p>
          <div class="post-likes">
            <opaline-avatar-group look="gradient" size="24" max="3" alt="Liked by">
              {LIKES.map((s) => <opaline-avatar seed={s}></opaline-avatar>)}
            </opaline-avatar-group>
            <span class="muted">Liked by <b>Søren</b> and {LIKES.length - 1} others</span>
          </div>
          <ul class="comments">
            <li>
              <opaline-avatar seed="Priya Raman" look="initials" size="32" alt="Priya Raman"></opaline-avatar>
              <div><b>Priya Raman</b> The initials ones are so readable now.</div>
            </li>
            <li>
              <opaline-avatar seed="hana@inlay.dev" look="aura" size="32" alt="Hana Sato"></opaline-avatar>
              <div><b>Hana Sato</b> Same avatar on web, iOS and in the emails.</div>
            </li>
          </ul>
        </div>
        <footer class="demo-foot"><span class="demo-tag">Feed</span><code>&lt;opaline-avatar-group max="3"&gt;</code></footer>
      </article>

      <article class="card demo" data-cat="Teams">
        <div class="project">
          <div class="project-top">
            <span class="project-icon" aria-hidden="true">◆</span>
            <div><b>Website relaunch</b><span class="muted">Due Friday · 68%</span></div>
          </div>
          <div class="progress" aria-hidden="true"><span style="width:68%"></span></div>
          <div class="project-team">
            <opaline-avatar-group look="clay" size="32" max="4" alt="Project members">
              {TEAM.map((s) => <opaline-avatar seed={s}></opaline-avatar>)}
            </opaline-avatar-group>
            <span class="muted">{TEAM.length} members</span>
          </div>
        </div>
        <div class="chat" aria-label="Chat">
          <div class="msg">
            <opaline-avatar seed="grace@inlay.dev" look="clay" size="28" alt="Grace"></opaline-avatar>
            <p>Hero copy is final. Can someone check mobile?</p>
          </div>
          <div class="msg me">
            <p>On it, sending screenshots in 5.</p>
            <opaline-avatar seed="ada@inlay.dev" look="clay" size="28" alt="You"></opaline-avatar>
          </div>
        </div>
        <footer class="demo-foot"><span class="demo-tag">Project</span><code>&lt;opaline-avatar-group max="4"&gt;</code></footer>
      </article>

      <article class="card demo wide-demo" data-cat="SaaS">
        <div class="admin-head">
          <div><b>Members</b><span class="muted">{USERS.length} people in Inlay Workspace</span></div>
          <button class="btn" type="button">Invite</button>
        </div>
        <div class="table-wrap">
          <table class="admin-table">
            <thead><tr><th>Name</th><th>Role</th><th>Status</th><th class="hide-sm">Last active</th></tr></thead>
            <tbody>
              {USERS.map(([name, email, role, status, seen]) => (
                <tr>
                  <td>
                    <div class="who">
                      <opaline-avatar seed={email} look="initials" shape="squircle" size="36" text={name!.split(' ').map((w) => w[0]).join('')}></opaline-avatar>
                      <div><b>{name}</b><span class="muted">{email}</span></div>
                    </div>
                  </td>
                  <td>{role}</td>
                  <td><span class={`status ${status}`}>{status}</span></td>
                  <td class="hide-sm muted">{seen}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <footer class="demo-foot"><span class="demo-tag">Admin portal</span><code>look="initials" shape="squircle"</code></footer>
      </article>

      <article class="card demo" data-cat="Messaging">
        <div class="list-head"><b>Inbox</b><span class="pill-count">2 new</span></div>
        <ul class="inbox">
          {INBOX.map(([name, subject, preview, time, unread]) => (
            <li class={unread ? 'unread' : undefined}>
              <opaline-avatar seed={name as string} look="aura" size="40" alt={name as string}></opaline-avatar>
              <div class="inbox-text">
                <div class="inbox-top"><b>{name}</b><span class="muted">{time}</span></div>
                <span class="inbox-subject">{subject}</span>
                <span class="muted inbox-preview">{preview}</span>
              </div>
            </li>
          ))}
        </ul>
        <footer class="demo-foot"><span class="demo-tag">Inbox</span><code>look="aura"</code></footer>
      </article>

      <article class="card demo" data-cat="SaaS">
        <div class="switcher">
          <div class="switcher-current">
            <opaline-avatar seed="ada@inlay.dev" look="gradient" shape="circle" size="40" alt="Ada Lovelace"></opaline-avatar>
            <div><b>Ada Lovelace</b><span class="muted">ada@inlay.dev</span></div>
            <span class="check" aria-label="Signed in">✓</span>
          </div>
          <span class="switcher-label muted">Switch account</span>
          {[['Ada at Analytical', 'ada@analytical.co'], ['Inlay Design', 'design@inlay.dev']].map(([n, e]) => (
            <div class="switcher-row">
              <opaline-avatar seed={e} look="gradient" shape="circle" size="32"></opaline-avatar>
              <div><b>{n}</b><span class="muted">{e}</span></div>
            </div>
          ))}
          <div class="switcher-row add"><span class="add-icon" aria-hidden="true">+</span><span>Add another account</span></div>
        </div>
        <footer class="demo-foot"><span class="demo-tag">Account switcher</span><code>look="gradient" shape="circle"</code></footer>
      </article>

      <article class="card demo" data-cat="Social">
        <div class="list-head"><b>Weekly leaderboard</b><span class="muted">Points</span></div>
        <ol class="leaders">
          {LEADERS.map(([name, pts], i) => (
            <li class={i === 0 ? 'first' : undefined}>
              <span class="rank">{i + 1}</span>
              <opaline-avatar seed={name} look="clay" body="hood" size={i === 0 ? '44' : '32'} alt={name}></opaline-avatar>
              <b>{name}</b>
              <span class="pts">{pts}</span>
            </li>
          ))}
        </ol>
        <footer class="demo-foot"><span class="demo-tag">Leaderboard</span><code>look="clay" body="hood"</code></footer>
      </article>

      <article class="card demo" data-cat="SaaS">
        <div class="list-head"><b>Notifications</b><a href="#demos" class="muted small">Mark all read</a></div>
        <ul class="notes">
          {NOTES.map(([who, verb, what, when]) => (
            <li>
              <opaline-avatar seed={who} look="morph" size="36" alt={who}></opaline-avatar>
              <p><b>{who}</b> {verb} <b>{what}</b><span class="muted"> · {when}</span></p>
            </li>
          ))}
        </ul>
        <footer class="demo-foot"><span class="demo-tag">Notifications</span><code>look="morph"</code></footer>
      </article>

      <article class="card demo" data-cat="Teams">
        <div class="list-head"><b>Sprint 24</b><span class="muted">Board</span></div>
        <div class="kanban">
          {[['In progress', [['Billing page redesign', ['grace', 'linus']], ['Fix SSO redirect', ['mateo']]]], ['Review', [['Avatar groups', ['ada', 'priya', 'kofi', 'hana', 'olu']]]]].map(([col, cards]) => (
            <div class="kanban-col">
              <span class="kanban-title muted">{col as string}</span>
              {(cards as [string, string[]][]).map(([title, people]) => (
                <div class="kanban-card">
                  <span>{title}</span>
                  <opaline-avatar-group look="initials" size="22" max="3" alt="Assignees">
                    {people.map((p) => <opaline-avatar seed={p}></opaline-avatar>)}
                  </opaline-avatar-group>
                </div>
              ))}
            </div>
          ))}
        </div>
        <footer class="demo-foot"><span class="demo-tag">Kanban</span><code>look="initials" size="22"</code></footer>
      </article>

      <article class="card demo wide-demo" data-cat="Messaging">
        <div class="list-head"><b>Design sync</b><span class="live">● Live · 24:13</span></div>
        <div class="call">
          {CALL.map((name, i) => (
            <div class={`call-tile${i === 1 ? ' speaking' : ''}`}>
              <opaline-avatar seed={name} look={i % 2 ? 'clay' : 'morph'} finish="soft" size="72" alt={name}></opaline-avatar>
              <span class="call-name">{name}</span>
            </div>
          ))}
        </div>
        <footer class="demo-foot"><span class="demo-tag">Video call</span><code>size="72" finish="soft"</code></footer>
      </article>
    </div>

    <div class="demos-cta">
      <a class="btn primary pill lg" href={`${BASE}playground/`}>Make your own</a>
      <a class="btn pill lg" href={`${BASE}docs/`}>Read the docs</a>
    </div>
  </div>
</section>

<script>
  const filter = document.getElementById('demo-filter')!
  filter.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLElement>('[data-cat]')
    if (!b) return
    const cat = b.dataset.cat!
    for (const x of filter.children) x.setAttribute('aria-selected', String(x === b))
    for (const card of document.querySelectorAll<HTMLElement>('.demos > .demo'))
      card.hidden = cat !== 'All' && card.dataset.cat !== cat
  })
</script>
