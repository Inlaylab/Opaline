    "limit": "5 KB",
    "gzip": true
  },
  {
    "name": "core + aura",
    "path": [
      "packages/core/dist/index.js",
      "packages/core/dist/aura.js"
    ],
    "import": {
      "packages/core/dist/index.js": "{ createAvatar }",
      "packages/core/dist/aura.js": "{ aura }"
    },
    "limit": "4 KB",
    "gzip": true
  },
  {
    "name": "core + clay",
    "path": [
      "packages/core/dist/index.js",
