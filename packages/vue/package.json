{
  "name": "@inlaylab/opaline-vue",
  "version": "1.1.0",
  "description": "Seeded avatars for Vue 3: an SSR-safe Avatar component.",
  "keywords": [
    "avatar",
    "avatars",
    "svg",
    "seed",
    "deterministic",
    "identicon",
    "profile-picture",
    "placeholder",
    "vue",
    "vue3",
    "nuxt",
    "ssr"
  ],
  "homepage": "https://inlaylab.github.io/Opaline/",
  "bugs": {
    "url": "https://github.com/Inlaylab/Opaline/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Inlaylab/Opaline.git",
    "directory": "packages/vue"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "lint": "tsc -p tsconfig.json && prettier --check . --ignore-path ../../.prettierignore"
  },
  "peerDependencies": {
    "vue": ">=3.5"
  },
  "dependencies": {
    "@inlaylab/opaline": "workspace:*"
  },
  "devDependencies": {
    "@inlaylab/opaline-contract": "workspace:*",
    "@vitest/browser-playwright": "^5.1.0",
    "playwright": "^1.64.1",
    "vue": "^3.5.44"
  }
}
