{
  "name": "@inlaylab/opaline-element",
  "version": "0.4.0",
  "description": "<opaline-avatar>: seeded avatars as a framework-free custom element.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Inlaylab/opaline.git",
    "directory": "packages/element"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": true,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
