{
  "name": "@inlaylab/opaline-element",
  "version": "1.1.0",
  "description": "<opaline-avatar>: seeded avatars as a framework-free custom element.",
  "keywords": [
    "avatar",
    "avatars",
    "svg",
    "seed",
    "deterministic",
    "identicon",
    "profile-picture",
    "placeholder",
    "web-component",
    "custom-element"
  ],
  "homepage": "https://inlaylab.github.io/Opaline/",
  "bugs": {
    "url": "https://github.com/Inlaylab/Opaline/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Inlaylab/Opaline.git",
    "directory": "packages/element"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": true,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "lint": "tsc -p tsconfig.json && prettier --check . --ignore-path ../../.prettierignore"
  },
  "dependencies": {
    "@inlaylab/opaline": "workspace:*"
  },
  "devDependencies": {
    "@inlaylab/opaline-contract": "workspace:*",
    "@vitest/browser-playwright": "^5.1.0",
    "playwright": "^1.64.1"
  }
}
