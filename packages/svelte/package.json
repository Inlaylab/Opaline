{
  "name": "@inlaylab/opaline-svelte",
  "version": "1.1.1",
  "description": "Seeded avatars for Svelte 5: an SSR-safe Avatar component.",
  "keywords": [
    "avatar",
    "avatars",
    "svg",
    "seed",
    "deterministic",
    "identicon",
    "profile-picture",
    "placeholder",
    "svelte",
    "svelte5",
    "sveltekit",
    "ssr"
  ],
  "homepage": "https://inlaylab.github.io/Opaline/",
  "bugs": {
    "url": "https://github.com/Inlaylab/Opaline/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Inlaylab/Opaline.git",
    "directory": "packages/svelte"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "svelte": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "svelte-package -i src/lib -o dist",
    "test": "vitest run",
    "lint": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && prettier --check . --ignore-path ../../.prettierignore"
  },
  "peerDependencies": {
    "svelte": ">=5.20"
  },
  "dependencies": {
    "@inlaylab/opaline": "workspace:*"
  },
  "devDependencies": {
    "@inlaylab/opaline-contract": "workspace:*",
    "@sveltejs/package": "^3.0.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@vitest/browser-playwright": "^5.1.0",
    "playwright": "^1.64.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8"
  }
}
