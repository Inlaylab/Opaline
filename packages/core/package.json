{
  "name": "@inlaylab/opaline",
  "version": "0.4.0",
  "description": "Seeded, deterministic SVG avatars. Zero dependencies.",
  "keywords": [
    "avatar",
    "svg",
    "seed",
    "deterministic",
    "identicon",
    "profile-picture"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Inlaylab/opaline.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./morph": {
      "types": "./dist/morph.d.ts",
      "import": "./dist/morph.js"
    },
    "./gradient": {
      "types": "./dist/gradient.d.ts",
      "import": "./dist/gradient.js"
    },
    "./aura": {
      "types": "./dist/aura.d.ts",
      "import": "./dist/aura.js"
    },
    "./clay": {
      "types": "./dist/clay.d.ts",
      "import": "./dist/clay.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "lint": "tsc -p tsconfig.json && prettier --check . --ignore-path ../../.prettierignore"
  },
  "devDependencies": {
    "@vitest/browser-playwright": "^5.1.0",
    "playwright": "^1.64.1"
  }
}
