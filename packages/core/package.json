{
  "name": "@inlaylab/opaline",
  "version": "1.1.1",
  "description": "Seeded, deterministic SVG avatars. Zero dependencies.",
  "keywords": [
    "avatar",
    "avatars",
    "svg",
    "seed",
    "deterministic",
    "identicon",
    "profile-picture",
    "placeholder",
    "generator",
    "oklch",
    "zero-dependency",
    "png"
  ],
  "homepage": "https://inlaylab.github.io/Opaline/",
  "bugs": {
    "url": "https://github.com/Inlaylab/Opaline/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Inlaylab/Opaline.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./morph": {
      "types": "./dist/morph.d.ts",
      "import": "./dist/morph.js"
    },
    "./gradient": {
      "types": "./dist/gradient.d.ts",
      "import": "./dist/gradient.js"
    },
    "./aura": {
      "types": "./dist/aura.d.ts",
      "import": "./dist/aura.js"
    },
    "./clay": {
      "types": "./dist/clay.d.ts",
      "import": "./dist/clay.js"
    },
    "./initials": {
      "types": "./dist/initials.d.ts",
      "import": "./dist/initials.js"
    },
    "./png": {
      "types": "./dist/png.d.ts",
      "import": "./dist/png.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "lint": "tsc -p tsconfig.json && prettier --check . --ignore-path ../../.prettierignore",
    "test:perf": "vitest run --config vitest.perf.config.ts",
    "freeze": "node --experimental-strip-types scripts/freeze.ts"
  },
  "devDependencies": {
    "@vitest/browser-playwright": "^5.1.0",
    "playwright": "^1.64.1"
  }
}
